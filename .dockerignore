.env
.env.local
.env.development
.env.production
.env.staging
.env.test
*.pem
*.key
*.cert

# Tooling & editor
.cursor
.vscode
.idea
*.swp
*.swo

# Tests & coverage
coverage
.nyc_output

# Logs & caches
*.log
logs
.cache
.parcel-cache
.eslintcache

# OS
.DS_Store
Thumbs.db

# Large design sources not imported by the app (runtime uses public/)
Setup


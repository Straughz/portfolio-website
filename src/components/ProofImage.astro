---
import { Picture } from 'astro:assets';
import { resolveApprovedMedia, type ClearedMedia } from '../lib/media';

interface Props {
  media?: ClearedMedia;
  heroHolding?: boolean;
  hero?: boolean;
  clientFrame?: boolean;
  desaturate?: boolean;
  class?: string;
  sizes?: string;
}

const {
  media,
  heroHolding = false,
  hero = false,
  clientFrame = false,
  desaturate = false,
  class: className = '',
  sizes = hero ? '(max-width: 720px) 92vw, 32vw' : '(max-width: 720px) 92vw, 44vw',
} = Astro.props;
const image = media ? resolveApprovedMedia(media) : undefined;
const widths = image
  ? [...new Set([320, 480, 640, 800, 960, 1200, image.width].filter((width) => width <= image.width))].sort((a, b) => a - b)
  : [];
---

{image && media ? (
  <figure class:list={['proof-image', { 'proof-image--client': clientFrame, 'proof-image--desaturated': desaturate }, className]} style={`--proof-ratio: ${media.width} / ${media.height}; --proof-focus: ${media.focalPoint.x}% ${media.focalPoint.y}%`}>
    <Picture
      src={image}
      alt={media.alt}
      formats={['avif', 'webp']}
      fallbackFormat="jpeg"
      widths={widths}
      sizes={sizes}
      width={media.width}
      height={media.height}
      loading={hero ? 'eager' : 'lazy'}
      fetchpriority={hero ? 'high' : 'auto'}
      decoding="async"
    />
  </figure>
) : heroHolding ? (
  <figure class:list={['proof-image', 'proof-image--holding', className]}>
    <span>Cokpit screen pending clearance</span>
  </figure>
) : null}

<style>
  .proof-image {
    display: block;
    margin: 0;
    overflow: hidden;
    aspect-ratio: var(--proof-ratio, 16 / 10);
    background: var(--color-page);
  }
  .proof-image :global(picture),
  .proof-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .proof-image :global(img) {
    object-fit: cover;
    object-position: var(--proof-focus, center);
  }
  .proof-image--client {
    padding: 8px;
    background: var(--color-ink);
    border: 1px solid var(--color-rule);
    max-width: min(100%, 25vw);
  }
  .proof-image--desaturated :global(img) { filter: grayscale(1); }
  .proof-image--holding {
    display: grid;
    place-items: center;
    min-height: 180px;
    padding: 24px;
    border: 1px solid currentColor;
    color: var(--color-ink);
    text-align: center;
  }
</style>

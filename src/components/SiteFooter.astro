---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => path === href;
---

<footer class="site-footer">
  <div class="footer-inner page-container">
    <p>Nexus Vantage Group<br /><span>Design and software by Kavish Singh.</span></p>
    <nav aria-label="Footer navigation">
      <a href="/projects" aria-current={current('/projects') ? 'page' : undefined}>Work</a>
      <a href="/projects/graphic-design" aria-current={current('/projects/graphic-design') ? 'page' : undefined}>Print</a>
      <a href="/about" aria-current={current('/about') ? 'page' : undefined}>About</a>
      <a href="/contact" aria-current={current('/contact') ? 'page' : undefined}>Start a ticket</a>
      <a href="#top">Back to top</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-dark-surface);
    border-top: 1px solid var(--color-dark-accent);
    color: var(--color-dark-ink);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.5rem;
  }

  p {
    margin: 0;
    line-height: 1.5;
  }

  p span {
    color: var(--color-dark-accent);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: inherit;
    white-space: nowrap;
  }

  a:hover {
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  a[aria-current='page'] {
    font-weight: var(--font-weight-bold);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.3em;
  }

  .site-footer :focus-visible {
    outline-color: var(--color-focus-dark);
  }

  @media (max-width: 30rem) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

---
import flatMark from '../assets/identity/nvg-monogram.svg';
import engravedMark from '../assets/identity/nvg-monogram-engraved-woven.svg';
import smallMark from '../assets/identity/nvg-monogram-small.svg';
---

<div class="inquiry-wait" data-waiting-indicator hidden aria-hidden="true">
  <span class="inquiry-wait-ring" aria-hidden="true"></span>
  <span class="inquiry-wait-stone" aria-hidden="true">
    <img class="inquiry-wait-flat" data-src={flatMark.src} width="72" height="72" alt="" />
    <img class="inquiry-wait-engraved" data-src={engravedMark.src} width="72" height="72" alt="" />
    <img class="inquiry-wait-small" data-src={smallMark.src} width="48" height="48" alt="" />
  </span>
</div>

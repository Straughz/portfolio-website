---
import EngravedSeal from '../EngravedSeal.astro';
import '../../styles/about-seal.css';
---

<section class="about-seal" id="about" aria-labelledby="about-seal-title">
  <div class="about-seal__inner page-container">
    <div class="about-seal__account">
      <h2 id="about-seal-title">I stay with the work.</h2>
      <p>I design print pieces, build websites and apps, and make tools of my own. I also care for the work after it is built.</p>
      <div class="about-seal__contact" id="contact">
        <p>Have a project in mind?</p>
        <a href="/contact">Start a ticket <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="about-seal__plate">
      <EngravedSeal />
    </div>
  </div>
</section>

<script src="../../scripts/seal-reveal.ts"></script>

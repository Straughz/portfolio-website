---
import { getPrintEntries } from '../../lib/content';
import PrintPiece from '../PrintPiece.astro';
import '../../styles/print.css';

const pieces = await getPrintEntries();
---

<section class="print-work" id="print" aria-labelledby="print-work-title">
  <div class="print-work__inner">
    <header class="print-work__heading">
      <div>
        <p class="print-work__kicker">The print drawer</p>
        <h2 id="print-work-title">Print belongs here too.</h2>
      </div>
      <p>These pieces are work I designed while working at The UPS Store. They are not Nexus Vantage Group client work.</p>
    </header>

    <ol class="print-work__list">
      {pieces.map((entry) => <PrintPiece entry={entry} />)}
    </ol>
  </div>
</section>

---
import { SERVICE_LABELS } from '../../lib/services';
import '../../styles/services.css';

const descriptions: Record<(typeof SERVICE_LABELS)[number], string> = {
  'Brand and print': 'Identity, paper pieces, and the files that make them.',
  Website: 'A public face built for the people using it.',
  'Customer apps': 'Tools your customers use to get a task done.',
  'Internal software': 'The systems that support the work out of public view.',
  Care: 'Updates, fixes, and infrastructure I run.',
};
---

<section class="services" id="services" aria-labelledby="services-title">
  <h2 id="services-title">What I can make and maintain.</h2>
  <ul class="service-list">
    {SERVICE_LABELS.map((service) => (
      <li>
        <h3>{service}</h3>
        <p>{descriptions[service]}</p>
      </li>
    ))}
  </ul>
  <a class="services__link" href="/contact">Start a ticket <span aria-hidden="true">↗</span></a>
</section>

---
import { getImage } from 'astro:assets';
import type { PrintEntry } from '../../lib/content';
import { resolveApprovedMedia } from '../../lib/media';
import '../../styles/print-viewer.css';

interface Props { entry: PrintEntry }

const { entry } = Astro.props;
const { title, slug, viewer } = entry.data;
const faces = await Promise.all(viewer.faces.map(async (face) => {
  const image = resolveApprovedMedia(face.image);
  const optimized = await getImage({ src: image, width: Math.min(image.width, 1600), format: 'webp' });
  const fallback = await getImage({ src: image, width: Math.min(image.width, 1600), format: 'jpeg' });
  return { src: optimized.src, fallback: fallback.src, alt: face.alt, width: image.width, height: image.height };
}));
const stillsId = `print-stills-${slug}`;
const viewLabel = viewer.kind === 'card' && faces.length > 1
  ? 'business card, front and back'
  : viewer.kind === 'brochure' && faces.length >= 4
    ? 'brochure, four pages'
    : entry.data.medium.toLowerCase();
---

<a
  class="print-piece__open"
  href={`#${stillsId}`}
  data-print-viewer
  data-viewer-kind={viewer.kind}
  data-viewer={JSON.stringify({ title, kind: viewer.kind, faces: faces.map(({ src, alt, width, height }) => ({ src, alt, width, height })) })}
  aria-label={`View ${title}, ${viewLabel}`}
>
  <picture class="print-piece__art">
    <source srcset={faces[0].src} type="image/webp" />
    <img src={faces[0].fallback} alt="" width={faces[0].width} height={faces[0].height} loading="lazy" decoding="async" />
  </picture>
</a>
<div class="print-piece__stills" id={stillsId} aria-label={`${title} flat stills`}>
  <p class="print-piece__stills-heading">Flat stills</p>
  {faces.map((face) => (
    <picture>
      <source srcset={face.src} type="image/webp" />
      <img src={face.fallback} alt={face.alt} width={face.width} height={face.height} loading="lazy" decoding="async" />
    </picture>
  ))}
  <a href={`#print-${slug}`}>Back to piece</a>
</div>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-print-viewer]');
  let viewerModule: Promise<typeof import('./viewer')> | undefined;
  const loadViewer = () => viewerModule ??= import('./viewer');

  for (const link of links) {
    link.addEventListener('click', async (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;
      event.preventDefault();
      try {
        (await loadViewer()).openPiece(link);
      } catch {
        window.location.href = link.href;
      }
    });
  }

  const section = document.querySelector('.print-work');
  if (section && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      if (entries.some((entry) => entry.isIntersecting)) {
        void loadViewer();
        observer.disconnect();
      }
    }, { rootMargin: '400px' });
    observer.observe(section);
  }
</script>

---
import SiteLayout from '../layouts/SiteLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import '../styles/routes.css';
---

<SiteLayout
  title="Contact"
  description="Contact Kavish Singh at Nexus Vantage Group about a website, app, software or design project."
>
  <header class="route-intro route-intro--contact">
    <p class="route-kicker">Contact</p>
    <h1>Start a ticket.</h1>
    <p>Tell me about the work you have in mind. Describe what you need in the project details field.</p>
  </header>
  <InquiryForm />
</SiteLayout>

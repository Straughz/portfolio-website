---
import SiteLayout from '../../layouts/SiteLayout.astro';
import WorkRow from '../../components/WorkRow.astro';
import { getWorkEntries } from '../../lib/content';
import '../../styles/work.css';
import '../../styles/routes.css';

const work = await getWorkEntries();
---

<SiteLayout
  title="Projects"
  description="Client websites and apps, plus software products by Kavish Singh."
>
  <div class="route-page">
    <header class="route-intro">
      <p class="route-kicker">Work</p>
      <h1>Projects</h1>
      <p>I build public websites, customer software and tools of my own. Each entry shows its current status.</p>
    </header>
    <nav class="route-categories" aria-label="Work categories">
      <a href="/projects" aria-current="page">All projects</a>
      <a href="/projects/web-design">Client Work</a>
      <a href="/projects/prospect">Products</a>
      <a href="/projects/graphic-design">Print Work</a>
    </nav>
    <section class="route-work" aria-labelledby="all-work-title">
      <h2 id="all-work-title">Client work and studio products</h2>
      <ol class="selected-work__list">
        {work.map((entry) => <WorkRow entry={entry} />)}
      </ol>
    </section>
    <aside class="route-action" aria-label="Start an inquiry">
      <p>Want to discuss a project?</p>
      <a href="/contact">Start a ticket <span aria-hidden="true">↗</span></a>
    </aside>
  </div>
</SiteLayout>

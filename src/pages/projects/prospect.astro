---
import SiteLayout from '../../layouts/SiteLayout.astro';
import WorkRow from '../../components/WorkRow.astro';
import { getStudioProductEntries } from '../../lib/content';
import '../../styles/work.css';
import '../../styles/routes.css';

const work = await getStudioProductEntries();
---

<SiteLayout
  title="Products"
  description="Software products and studio tools built by Kavish Singh."
>
  <div class="route-page page-container">
    <header class="route-intro">
      <p class="route-kicker">Work / studio</p>
      <h1>Products</h1>
      <p>I build tools for my own work and for other builders. Cokpit is in progress; NVG Voice is a tool I use daily.</p>
    </header>
    <nav class="route-categories" aria-label="Work categories">
      <a href="/projects">All</a>
      <a href="/projects/web-design">Client</a>
      <a href="/projects/prospect" aria-current="page">Products</a>
      <a href="/projects/graphic-design">Print</a>
    </nav>
    <section class="route-work" aria-labelledby="products-title">
      <h2 id="products-title">The tools</h2>
      <ol class="selected-work__list">
        {work.map((entry) => <WorkRow entry={entry} />)}
      </ol>
    </section>
    <aside class="route-action" aria-label="Start an inquiry">
      <p>Have software work to discuss?</p>
      <a href="/contact">Start a ticket <span aria-hidden="true">↗</span></a>
    </aside>
  </div>
</SiteLayout>
